# Environment for a standalone run of the server (npm run dev in server/). The Home Assistant add-on
# does not read this file: its run script exports the add-on options instead. Generated from
# ecoflow_panel/config.yaml (order and defaults) and the OPTIONS table in server/src/config.ts (one
# line per variable); every option is in docs/guide/options.md.

# --- Deployment (set by the image inside the add-on) ---
# HTTP port (8787; ingress needs it).
PORT=8787
# Bind address; '::' listens dual-stack. Local development binds loopback only.
HOST=127.0.0.1
# SQLite path, relative to server/.
DB_PATH=../data/ecoflow.db

# --- Credentials & core — the only fields a fresh install must set ---
# EcoFlow IoT-Open API access key; required (the run script exits without it, the getter throws on first use).
ECOFLOW_ACCESS_KEY=your_access_key_here
# EcoFlow IoT-Open API secret; required.
ECOFLOW_SECRET_KEY=your_secret_key_here
# EcoFlow cloud API base URL.
ECOFLOW_API_HOST=https://api-a.ecoflow.com
# Pino log level.
LOG_LEVEL=info

# --- Site location — used only for the solar day-ahead forecast ---
# Site latitude for the solar forecast and the day/night test; the default is a placeholder.
FORECAST_LAT=33.4484
# Site longitude for the solar forecast and the day/night test; the default is a placeholder.
FORECAST_LON=-112.074

# --- Notifications — per-alert push (per-field help: docs/guide/options.md) ---
# Home Assistant notifications on ('ha') or off; anything else fails safe to 'none'.
NOTIFY_CHANNEL=none
# Minimum severity that pushes; anything but 'critical' reads as 'warning'.
NOTIFY_MIN_SEVERITY=warning
# Also push when an alert clears.
NOTIFY_RESOLVED=1
# HA notify services that receive the push (comma list; a notify. prefix is dropped; only [a-z0-9_] names kept).
NOTIFY_HA_PUSH_TARGETS=
# Critical pushes carry the companion app's critical payload. The run script exports 1/0 because this reads `!== '0'`.
NOTIFY_CRITICAL_BYPASS_DND=1
# Push quiet window HH-HH; a blank or malformed value means no window.
NOTIFY_QUIET_HOURS=22-06
# Hour of the morning digest. Bare Number(): a blank reads as 0.
NOTIFY_DIGEST_HOUR=7

# --- Audible broadcast — spoken alarms + chimes over HA media_player speakers ---
# Master enable for audible broadcast (the /data runtime override wins when set).
BROADCAST_ENABLED=false
# Music-Assistant media_player targets (comma list; only media_player.* entries kept).
BROADCAST_TARGETS=
# Announce-only media_player targets; an entry also in BROADCAST_TARGETS is dropped here.
BROADCAST_SIP_TARGETS=
# Minimum severity for an audible broadcast; anything but 'warning' reads as 'critical'.
BROADCAST_MIN_SEVERITY=critical
# Audible quiet window HH-HH. Absent reads as no window (the add-on always exports it).
BROADCAST_QUIET_HOURS=22-06
# Critical alerts break through quiet hours (push and audible).
CRITICAL_BREAKS_QUIET_HOURS=false
# Base URL the speakers fetch audio from; a blank reads as the default; a trailing slash is dropped.
BROADCAST_AUDIO_BASE=http://homeassistant.local:8787
# Chime volume 0..1; non-finite reads as 0.5.
BROADCAST_VOLUME=0.5
# Announce volume 0..100; 'off'/'none'/'standing' omit it (null); blank follows BROADCAST_VOLUME × 100.
BROADCAST_ANNOUNCE_VOLUME=
# Play the platform's pre-announce tone.
BROADCAST_USE_PRE_ANNOUNCE=false
# Lead-in silence in ms; absent, blank or malformed reads as 1500 (the add-on ships 1000).
BROADCAST_LEAD_SILENCE_MS=1000
# Announcement repeats.
BROADCAST_REPEAT=2
# Gap between repeats.
BROADCAST_REPEAT_GAP_MS=1500
# Gap between the chime and the speech.
BROADCAST_CHIME_GAP_MS=1000
# Retries of a failed announce call.
BROADCAST_ANNOUNCE_RETRIES=1
# Wyoming/Piper host; a blank reads as the default.
BROADCAST_WYOMING_HOST=core-piper
# Wyoming port; 0, blank or malformed reads as 10200.
BROADCAST_WYOMING_PORT=10200
# Piper voice (English); blank means the server default (null).
BROADCAST_WYOMING_VOICE=
# Second pass in Spanish; off only for 'false' or '0'.
BROADCAST_BILINGUAL=false
# Piper voice for the Spanish pass (trimmed; blank = inactive).
BROADCAST_WYOMING_VOICE_ES=

# --- Battery & grid alarms ---
# State-of-charge ladder alarm.
BATTERY_SOC_ALARM_ENABLED=true
# Runway (time-to-reserve) alarm.
BATTERY_RUNWAY_ALARM_ENABLED=true
# Re-announce cadence, read as milliseconds: max(1, Number(raw ?? 60)) minutes.
BATTERY_RUNWAY_ALARM_REANNOUNCE_MIN=60
# Grid-tied site; only the string 'true' counts.
GRID_AVAILABLE=false
# HA entity reporting grid presence (trimmed).
GRID_PRESENCE_ENTITY=
# Points above the reserve where a flow-less grid stops being trusted; absent, blank, 'null' or garbage read as 1.5.
GRID_FLOOR_SLACK_PCT=1.5
# Response to on-peak Charge Now: off | advisory | supervised; anything else fails to 'advisory'.
CHARGE_NOW_RESPONSE=advisory
# HA binary_sensor for the host's under-voltage flag (trimmed).
HOST_POWER_ENTITY=

# --- Load-shedding advisor (read + advise only; never actuates) ---
# Load-shedding advisor.
LOAD_SHEDDING_ADVISORY_ENABLED=true
# Shed candidates, entity:priority:label:watts:channel per entry (parsed by loadShedRegistry.ts; absent and blank alike give none).
LOAD_SHEDDING_SHED_ENTITIES=
# Runway hours below which shedding is advised. Bare Number().
LOAD_SHEDDING_RUNWAY_THRESHOLD_H=4.0
# Margin above the threshold before restoring is advised. Bare Number().
LOAD_SHEDDING_RESTORE_MARGIN_H=2.0

# --- Night-charge TOU-arbitrage engine. Write posture per NIGHT_CHARGE_MODE: ---
# advisory (default, never writes) | supervised (one announced, cancellable,
# bounded, auto-reverting reserve write per charge night) | auto (gated).
# With ARB_OBJECTIVE cost and ARB_COST_MAX_SOC_PCT above 50, a supervised or
# auto night also sets the panel's force-charge ceiling (80-100, restored
# afterwards) and switches force charge ON then OFF per Core slot.
# Night-charge planner.
NIGHT_CHARGE_ADVISOR_ENABLED=true
# advisory | supervised | auto; anything else fails closed to 'advisory'.
NIGHT_CHARGE_MODE=advisory
# Legacy cushion, percent of pool. Bare Number().
ARB_OUTAGE_CUSHION_PCT=15
# Hours of outage the cushion must carry. Bare Number().
ARB_OUTAGE_CUSHION_HOURS=4
# Multiplier on the measured islanded load. Bare Number().
ARB_ISLANDED_LOAD_SAFETY=1.25
# 'cost' (case-insensitive) or 'resilience'.
ARB_OBJECTIVE=resilience
# Cost-mode fill ceiling. Bare Number().
ARB_COST_MAX_SOC_PCT=90
# Below this buy the night is a hold (also the clean-baseline bound in scoring). Bare Number().
ARB_MIN_BUY_KWH=1
# Grid-side charge cap; 0 = automatic (planChargeCapKw). Bare Number().
ARB_CHARGE_CAP_KW=0
# Shared grid-input envelope in kW; 0, negative or unparseable reads as null (contention not modelled).
ARB_GRID_INPUT_CAP_KW=17
# Floor of the load-band multiplier. Bare Number().
ARB_LOAD_P90_FACTOR=1.15
# Hour of the evening job, clamped to 0..22 (the catch-up window ends at 23:00); non-finite reads as 21.
NIGHT_CHARGE_NOTIFY_HOUR=21
# Minute of the evening job; non-finite reads as 30.
NIGHT_CHARGE_NOTIFY_MINUTE=30
# Send the nightly notice on hold nights too.
NIGHT_CHARGE_NOTIFY_ON_HOLD=true

# --- APS R-EV effective ¢/kWh (enter from a bill; blank = unconfirmed → $ output null) ---
# Outside dead-man receiver (https URL, trimmed); blank = off. Validation stays in heartbeat.ts.
HEARTBEAT_URL=
# Seconds between pings, clamped to 60..3600 and read as milliseconds; absent, blank or malformed reads as 300 s.
HEARTBEAT_INTERVAL_S=300
# APS R-EV effective ¢/kWh for the period and season; blank = unconfirmed (null); any finite value counts.
TARIFF_APS_ONPEAK_SUMMER_CENTS=
# APS R-EV effective ¢/kWh for the period and season; blank = unconfirmed (null); any finite value counts.
TARIFF_APS_ONPEAK_WINTER_CENTS=
# APS R-EV effective ¢/kWh for the period and season; blank = unconfirmed (null); any finite value counts.
TARIFF_APS_OFFPEAK_SUMMER_CENTS=
# APS R-EV effective ¢/kWh for the period and season; blank = unconfirmed (null); any finite value counts.
TARIFF_APS_OFFPEAK_WINTER_CENTS=
# APS R-EV effective ¢/kWh for the period and season; blank = unconfirmed (null); any finite value counts.
TARIFF_APS_OVERNIGHT_CENTS=
# APS R-EV effective ¢/kWh for the period and season; blank = unconfirmed (null); any finite value counts.
TARIFF_APS_SUPEROFFPEAK_WINTER_CENTS=
# The rates come from a bill; only the string 'true' counts.
TARIFF_APS_RATES_CONFIRMED=false

# --- Integrations (opt-in): NWS storm alerts + MQTT auto-discovery ---
# NWS storm alerts; '1' or 'true' (any case).
NWS_ENABLED=0
# MQTT discovery: '1' or 'true' (any case) AND a non-empty MQTT_DISCOVERY_HOST.
MQTT_DISCOVERY_ENABLED=0
# MQTT broker host, verbatim; a blank disables discovery.
MQTT_DISCOVERY_HOST=
# MQTT broker port. Bare Number().
MQTT_DISCOVERY_PORT=1883
# MQTT username, verbatim (a blank is passed through).
MQTT_DISCOVERY_USER=
# MQTT password, verbatim.
MQTT_DISCOVERY_PASS=
# Discovery topic prefix; a blank passes through as an empty prefix.
MQTT_DISCOVERY_PREFIX=homeassistant

# --- SSH control-room TUI (LAN; password login — every login is refused until TUI_PASSWORD is set) ---
# v1.7.0 (security #5, CWE-1188) — default OFF: a control plane published on the host
# LAN is not on by default on a fresh install. Opt in by setting this true.
# SSH console listener; off only for '0' (absent reads as on — the run script always exports 1 or 0). Also on while the deprecated TELNET_ENABLED alias is '1'.
SSH_ENABLED=0
# SSH console port. Bare Number(); while it is at its default 2323 a different finite TELNET_PORT applies instead.
SSH_PORT=2323

# --- Deprecated aliases of SSH_ENABLED / SSH_PORT, kept so an existing install needs no ---
# change (an option key is never renamed): either enabled option serves SSH, and
# SSH_PORT at its default 2323 defers to TELNET_PORT. Telnet itself is no longer served.
# Deprecated alias of SSH_ENABLED: '1' serves the SSH console while SSH_ENABLED is '0' (telnet is no longer served); the run script always exports 1 or 0.
TELNET_ENABLED=0
# Deprecated alias of SSH_PORT, applied only while SSH_PORT is at its default 2323 and this is a different finite port.
TELNET_PORT=2323
# Console login username (trimmed; blank reads as 'operator'); the gate is off while TUI_PASSWORD is blank.
TUI_USERNAME=
# Console login password (trimmed); blank disables the login gate.
TUI_PASSWORD=
# Exact browser origins added to the same-origin set (comma list).
TUI_TRUSTED_ORIGINS=

# --- Diagnostic / advanced (leave default unless you know you need them) ---
# Raw-sample retention in days, rounded and clamped to 7..3650; absent, blank or malformed reads as 30.
RECORDER_RETENTION_DAYS=30
# SN → HA ping entity JSON map (trimmed; parsed and validated by deviceLink.ts).
ECOFLOW_DEVICE_REACHABILITY=
# Any non-empty value unlocks POST /api/device/send-command.
WRITE_DEBUG_TOKEN=

# --- Your home: optional keys with no default (docs/guide/your-home.md). The add-on passes one ---
# only while it is set, so each is commented out here: absent, the built-in behaviour applies.
# The site's IANA time zone (e.g. Europe/Berlin), trimmed; unset or blank falls through to TZ, then America/Phoenix. siteTime.ts validates it with Intl once at boot: a value the runtime cannot resolve raises a repair issue and falls through.
# SITE_TIMEZONE=
# The tariff preset: aps_r_ev (unset: the built-in APS R-EV table), flat, two_tier or custom; an unknown value fails closed (tariff.ts).
# TARIFF_PLAN=
# The custom plan's periods in the period grammar (tariff.ts); trimmed, null when unset.
# TARIFF_PERIODS=
# The custom plan's ¢/kWh per period and season (tariff.ts); trimmed, null when unset.
# TARIFF_RATES=
# The rates of the plan in effect come from a bill; only 'true' counts; null when unset (TARIFF_APS_RATES_CONFIRMED then decides).
# TARIFF_RATES_CONFIRMED=
# Fixed daily basic-service charge in ¢ (informational; surfaced only once confirmed); null when unset, NaN when not a number (fails closed).
# TARIFF_FIXED_DAILY_CENTS=
# Usage months that are summer, e.g. 4-9 or a wrapping 10-3; null when unset (the preset's 4-9).
# TARIFF_SUMMER_MONTHS=
# aps, none or a comma list of YYYY-MM-DD dates; null when unset (aps for aps_r_ev, none otherwise).
# TARIFF_HOLIDAYS=
# ISO 4217 code of the money figures (one of money.ts CURRENCIES); null when unset (USD).
# TARIFF_CURRENCY=
# Overrides the period the night charge plans in (the model's cheapPeriodId); must name a period of the plan; null when unset.
# NIGHT_CHARGE_CHEAP_PERIOD=
# Flat ¢/kWh when the rates are unconfirmed (one constant, TARIFF_FLAT_DEFAULT_CENTS); the flat plan's rate. Bare Number().
# TARIFF_FLAT_CENTS_PER_KWH=
# Two-tier on-peak ¢/kWh (KPI path); a value above zero only. The two_tier plan reads it raw.
# TARIFF_ON_PEAK_CENTS=
# Two-tier off-peak ¢/kWh (KPI path); a value above zero only. The two_tier plan reads it raw.
# TARIFF_OFF_PEAK_CENTS=
# Export ¢/kWh for the MPC. Bare Number().
# TARIFF_EXPORT_CENTS_PER_KWH=
# Legacy on-peak hours "start-end" for the two-tier fallback; the two_tier plan's on-peak window.
# TARIFF_ON_PEAK_HOURS=
# Legacy on-peak days "first-last" (1=Mon..7=Sun) for the two-tier fallback; the two_tier plan's on-peak days.
# TARIFF_ON_PEAK_DAYS=
# PV array nameplate in kWp; unset keeps the reference array (16.8 kWp). Setting any PV_* key moves the PV site onto FORECAST_LAT/LON.
# PV_ARRAY_KWP=
# PV array tilt from horizontal in degrees; unset keeps the reference tilt (25).
# PV_TILT_DEG=
# PV array azimuth in degrees clockwise from north (180 = due south); unset keeps 180.
# PV_AZIMUTH_DEG=
# PV strings per Core, e.g. hv=10x400,lv=4x400, with per-Core overrides keyed by slot or name (; slot2=hv=8x450); unset keeps 10 + 4 × 400 W.
# PV_STRINGS=
# Use Home Assistant's home latitude and longitude instead of FORECAST_LAT/LON (read in the background, applied from the next start).
# SITE_LOCATION_FROM_HA=
# Ceiling on predicted EV load per hour, per charger (W); clamped at ≥ 0 only (a NaN propagates). Schema int(0,)?. One reader since v1.191.0 (index.ts parsed it a second time, unclamped).
# EV_MAX_LOAD_W=
# EV chargers at the site: 0 none (no circuit is classed as EV), 1 overlapping predicted sessions are alternatives (MAX, today), 2..4 they add up (SUM, capped at count × EV_MAX_LOAD_W). Rounded and clamped; absent or malformed reads as 1.
# EV_CHARGER_COUNT=
# Watts above which a sustained circuit load is EV; any finite value ≥ 0, else 6000. Schema int(0,)?.
# EV_PLATEAU_MIN_W=
# SHP2 channels (1..12, comma list) the EV detectors scan; a paired circuit is scanned when either leg is listed. Absent, or no valid channel: every circuit.
# EV_CIRCUITS=
# Bench-spare serials, comma-separated, or `none`. When set it REPLACES the built-in SPARE_DPU_SNS list as the spare floor (never a union); the roster override still applies on top. Unset or blank: the built-in list.
# BENCH_SPARE_SNS=
# Display names by serial, as a JSON object; merged over <dataRoot>/device-aliases.json, which is merged over the image file. Unreadable JSON is skipped and raises a repair item. Unset or blank: the files alone.
# DEVICE_ALIASES=
# kW each connected Core takes into its pack while force-charging; absent, blank, 0 or not a positive number reads as null (the measured 5.5 kW). ARB_CHARGE_CAP_KW > 0 still sets the planner cap.
# FORCE_CHARGE_KW_PER_CORE=
# Pool standby overhead floor (W), clamped; decimals accepted (schema float(0,1500)?).
# RUNWAY_POOL_OVERHEAD_FLOOR_W=
# Per-Core standby overhead (W), clamped; decimals accepted (schema float(0,500)?).
# RUNWAY_CORE_OVERHEAD_W=
# Floor-vs-live gap that re-seeds the lifetime floors (about one Core's capacity). Bare Number(); schema int?.
# BMS_RESEED_MIN_GAP_WH=
# Lowest measured capacity scale applied to the panel's nameplate energies (runway, forecast, idle-pool check, secondary-panel runway); absent, blank or malformed reads as 0.8; clamped to 0.5..1.
# CAPACITY_SCALE_MIN=
# First hour of the overnight blend band, rounded and clamped (a NaN propagates); schema int(0,23)?.
# FORECAST_NIGHT_START_HOUR=
# Last hour of the overnight blend band, rounded and clamped (a NaN propagates); schema int(0,23)?.
# FORECAST_NIGHT_END_HOUR=
# Grid carbon intensity (lb CO2 per MWh) for the avoided-CO2 figures. Bare Number(); schema float?.
# GRID_CO2_INTENSITY_LB_PER_MWH=
# Base cycling wear cost (USD per kWh) for the MPC. Bare Number(); schema float?.
# CYCLING_BASE_WEAR_USD_PER_KWH=
# Curtailment suggestions, id:watts:category[:label] per entry (category pool|ev|water|hvac|other, else other); `none` = no suggestions; absent or no valid entry keeps the built-in list.
# OPPORTUNISTIC_LOADS=
# SoC alarm rungs, pct:tier per entry (pct 1..99, tier low|medium|high|critical); absent or no valid rung keeps 50/40/30/20/15/10/8/4/2.
# BATTERY_SOC_LADDER=
