# dependencies
node_modules/
# ...and a bare entry, so a SYMLINK named node_modules is ignored too. The
# trailing-slash form matches a directory only: on 2026-09-04 a self-referential
# symlink (server/node_modules -> itself) slipped past it, got committed, and
# broke `tsc` with ELOOP on every checkout that had it.
node_modules

# build artifacts
dist/
web/dist/
server/dist/
*.tsbuildinfo

# working notes / one-off inventories kept beside the checkout, never published
/*-inventory-*.md
/*-proposal-*.md

# env / secrets — never commit
.env
.env.local
.env.production

# logs
*.log

# OS / editor
.DS_Store
.vscode/
.idea/

# local data (SQLite recorder + per-run scratch)
data/
tmp/
.tmp/

# Claude session/scratch (kept local)
.claude/
